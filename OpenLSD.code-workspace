{
	// We include only the current folder in our workspace
	"folders": [
		{
			"path": "."
		}
	],

	// Workspace-specific settings
	"settings": {
		// Disable the C/C++ plugin IntelliSense engine, as we use clangd
		// for this purpose and need to prevent them from clashing.
		"C_Cpp.intelliSenseEngine": "disabled",
		"remote.autoForwardPorts": false,
		"clangd.onConfigChanged": "restart",

		// Disable autocomplete from inserting hallucinated headers
		"clangd.arguments": ["--header-insertion=never"],

		// Hide caches and CLion config folder
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/CVS": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			"**/.idea": true,
			"**/.cache": true,
			"**/__pycache__": true,
		},

		// File indentation
		"editor.detectIndentation": false,
		"editor.insertSpaces": false,
		"files.insertFinalNewline": true,
		"files.trimFinalNewlines": true,
		
		"[python]": {
			"editor.insertSpaces": true,
			"editor.tabSize": 4
		},

		"[yaml][markdown]": {
			"editor.insertSpaces": true,
			"editor.tabSize": 2
		},
		"python.analysis.typeCheckingMode": "strict",
	},

	"extensions": {
		"recommendations": [
			"ms-python.python",
			"llvm-vs-code-extensions.vscode-clangd",
			"ms-azuretools.vscode-docker",
			"GitLab.gitlab-workflow",
			"13xforever.language-x86-64-assembly",
			"ms-vscode.hexeditor",
			"ms-vscode.cpptools",
			"ZixuanWang.linkerscript",
			"rioj7.command-variable",
			"mcu-debug.memory-view",
			"whatwewant.open-terminal",
			"redhat.vscode-yaml",
			"xaver.clang-format",
			"digitallab.digitallab-vscode-extension",
		]
	},

	// Tasks integration to enable easy build and clean
	"tasks": {
		"version": "2.0.0",

		// Default configuration 
		"type": "shell",
		"command": "make",
		"presentation": {
			"echo": false
		},
		"problemMatcher": [],

		"inputs": [
			{
				"id": "lab",
				"type": "command",
				"command": "extension.commandvariable.pickStringRemember",
				"args": {
					"description": "Choose which lab to test",
					"fileName": "${workspaceFolder}/.vscode/labs.json",
					"fileFormat": "json",
					"jsonOption": {
						"label": "'Lab '+content[__itemIdx__]",
						"value": {
							"lab": "content[__itemIdx__]",
						},
					},
					"key": "lab",
					"addLabelToTop": "Lab ${remember:lab}",
				}
			},
			{
				"id": "tests",
				"type": "command",
				"command": "extension.commandvariable.pickStringRemember",
				"args": {
					"description": "Choose the tests to run (empty = ALL tests)",
					"fileName": "${workspaceFolder}/.vscode/lab${remember:lab}.json",
					"fileFormat": "json",
					"jsonOption": {
						"label": "content[__itemIdx__].friendly_name",
						"description": "content[__itemIdx__].name",
						"detail": "content[__itemIdx__].description",
						"value": {
							"tests": "content[__itemIdx__].name",
						},
					},
					"key": "tests",
					"multiPick": true,
					"joinByKey": true,
				}
			},
			{
				"id": "test",
				"type": "command",
				"command": "extension.commandvariable.pickStringRemember",
				"args": {
					"description": "Choose the test to run",
					"fileName": "${workspaceFolder}/.vscode/lab${remember:lab}.json",
					"fileFormat": "json",
					"jsonOption": {
						"label": "content[__itemIdx__].friendly_name",
						"description": "content[__itemIdx__].name",
						"detail": "content[__itemIdx__].description",
						"value": {
							"test": "content[__itemIdx__].name",
							"testLabel": "content[__itemIdx__].friendly_name",
						},
					},
					"key": "test",
					"addLabelToTop": "${remember:testLabel}",
				},
			},
		],

		"tasks": [
			{
				"label": "Build OpenLSD kernel",
				"args": [ "all" ],
				"group": {
					"kind": "build",
					"isDefault": true
				},
			},
			{
				"label": "Run OpenLSD",
				"args": [ "run" ],
				"isBackground": true,

				"presentation": {
					"focus": true
				},
			},
			{
				"label": "Run Tests in OpenLSD",
				"command": "./test.py ${input:lab} ${input:tests}",
				"isBackground": true,

				"presentation": {
					"focus": true
				}
			},
			{
				"label": "Debug OpenLSD",
				"args": [ "run-gdb" ],
				"isBackground": true,
				
				"problemMatcher": [
					{
						// We need this custom matcher that does nothing to keep VSC happy
						"pattern": [
							{
								"regexp": ".",
								"file": 1,
								"location": 2,
								"message": 3,
							}
						],

						// We indicate that the debug task "finishes" when QEMU has started.
						// At this point, VS Code will start GDB and connect to QEMU for debugging
						"background": {
							"activeOnStart": true,
							"endsPattern": "^\\*\\*\\* Run 'make gdb' to attach a debugger",
							"beginsPattern": ".",
						}
					}
				],
			},
			{
				"label": "Debug Test in OpenLSD",
				"args": [ "run-gdb", "TEST=lab${input:lab}_${input:test}" ],
				"isBackground": true,
				
				"problemMatcher": [
					{
						// We need this custom matcher that does nothing to keep VSC happy
						"pattern": [
							{
								"regexp": ".",
								"file": 1,
								"location": 2,
								"message": 3,
							}
						],

						// We indicate that the debug task "finishes" when QEMU has started.
						// At this point, VS Code will start GDB and connect to QEMU for debugging
						"background": {
							"activeOnStart": true,
							"endsPattern": "^\\*\\*\\* Run 'make gdb' to attach a debugger",
							"beginsPattern": ".",
						}
					}
				],
			},
			{
				"label": "Configure editor integrations",
				"args": [ "editor" ],
				"runOptions": {
					"runOn": "folderOpen"
				},
			},
			{
				"label": "Clean OpenLSD build",
				"args": [ "clean" ],
			}
		]
	},

	// Debugger configurations
	"launch": {
		"version": "0.2.0",

		"configurations": [
			{
				"name": "Debug Test for OpenLSD",
				"type": "cppdbg",
				"request": "launch",
				"preLaunchTask": "Debug Test in OpenLSD",
				"serverLaunchTimeout": 1000,

				// We attach to a remote debugger, inside QEMU
				"MIMode": "gdb",
				"miDebuggerServerAddress": "localhost:1234",
				
				// We specify the binary we are debugging (our kernel)
				"cwd": "${workspaceFolder}",
				"program": "${workspaceFolder}/obj/kernel/kernel",
				
				"stopAtEntry": false,
				"setupCommands": [
					{
						"description": "Enable pretty-printing for gdb",
						"text": "-enable-pretty-printing",
						"ignoreFailures": true
					},
					{
						"description": "Set Disassembly Flavor to Intel",
						"text": "-gdb-set disassembly-flavor intel",
						"ignoreFailures": true
					},
					{
						"description": "Change directory",
						"text": "cd ${workspaceFolder}",
						"ignoreFailures": false
					},
					{
						"description": "Load custom GDB settings from Makefile",
						"text": "source vsc.gdbrc",
						"ignoreFailures": false
					},
				],
			},
			{
				"name": "Debug OpenLSD",
				"type": "cppdbg",
				"request": "launch",
				"preLaunchTask": "Debug OpenLSD",
				"serverLaunchTimeout": 1000,

				// We attach to a remote debugger, inside QEMU
				"MIMode": "gdb",
				"miDebuggerServerAddress": "localhost:1234",
				
				// We specify the binary we are debugging (our kernel)
				"cwd": "${workspaceFolder}",
				"program": "${workspaceFolder}/obj/kernel/kernel",
				
				"stopAtEntry": false,
				"setupCommands": [
					{
						"description": "Enable pretty-printing for gdb",
						"text": "-enable-pretty-printing",
						"ignoreFailures": true
					},
					{
						"description": "Set Disassembly Flavor to Intel",
						"text": "-gdb-set disassembly-flavor intel",
						"ignoreFailures": true
					},
					{
						"description": "Change directory",
						"text": "cd ${workspaceFolder}",
						"ignoreFailures": false
					},
					{
						"description": "Load custom GDB settings from Makefile",
						"text": "source vsc.gdbrc",
						"ignoreFailures": false
					},
				],
			},
		]
	},
}
